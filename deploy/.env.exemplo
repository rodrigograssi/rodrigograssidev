# Copie para deploy/.env e ajuste para o seu Swarm

# Imagem publicada no registry (GHCR ou Docker Hub), com a tag a publicar
IMAGEM=ghcr.io/SEU-USUARIO/rodrigograssidev:latest

# Configuração do Traefik existente
TRAEFIK_REDE=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
