---
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import StatusPill from "../../components/StatusPill.astro";
import { obterProjetosOrdenados, type Projeto } from "../../lib/projetos";

export async function getStaticPaths() {
  const projetos = await obterProjetosOrdenados();
  return projetos.map((projeto) => ({
    params: { slug: projeto.id },
    props: { projeto },
  }));
}

interface Props {
  projeto: Projeto;
}

const { projeto } = Astro.props;
const { nome, subdominio, tagline, descricao, status } = projeto.data;

// Corpo previsto: A origem, O que faz, Como funciona por dentro, Stack, Status
const temCorpo = Boolean(projeto.body?.trim());
const { Content } = await render(projeto);
---

<ArticleLayout
  titulo={nome}
  tituloPagina={`${nome} — Rodrigo Grassi`}
  descricao={`${tagline} ${descricao}`}
>
  <SectionLabel slot="antes-titulo" sobreRoxo>// o paiol</SectionLabel>

  <div slot="depois-titulo" class="detalhes">
    <p class="tagline">{tagline}</p>
    <div class="meta">
      <StatusPill status={status} />
      <span class="subdominio">{status === "engavetado" ? "no fundo do paiol" : subdominio}</span>
    </div>
  </div>

  <p>{descricao}</p>

  {temCorpo && <Content />}

  <div class="voltar">
    <a href="/#paiol"><span aria-hidden="true">←</span> Voltar para o paiol</a>
  </div>
</ArticleLayout>

<style>
  .tagline {
    margin-top: 20px;
    color: var(--on-roxo-soft);
    font-size: 21px;
    line-height: 1.6;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: 28px;
  }

  .subdominio {
    color: var(--on-roxo-label);
    font-family: var(--font-mono);
    font-size: 13px;
    overflow-wrap: anywhere;
  }

  .voltar {
    margin-top: 56px;
  }

  .voltar a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
  }

  .voltar a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .tagline {
      font-size: 17px;
    }

    .subdominio {
      font-size: 12px;
    }
  }
</style>
